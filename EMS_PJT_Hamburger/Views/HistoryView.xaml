<UserControl xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"  x:Class="EMS_PJT_Hamburger.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:s="http://schemas.abtsoftware.co.uk/scichart"
             mc:Ignorable="d"
             d:DesignHeight="900"
             d:DesignWidth="1380"
             Background="Transparent"
             FontFamily="/EMS_PJT_Hamburger;component/Fonts/#Noto Sans KR">
    <UserControl.Resources>
        <Style x:Key="PanelBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#D90F151B"/>
            <Setter Property="BorderBrush" Value="#284E5F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF76F7A8"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="MutedTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFD5D8DC"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FilterLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="TouchDatePickerStyle" TargetType="dxe:DateEdit">
            <Setter Property="Width" Value="170"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="{x:Type dx:SimpleButton}">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="86"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#24272B"/>
            <Setter Property="BorderBrush" Value="#5C6268"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#245D86"/>
                    <Setter Property="BorderBrush" Value="#4EA5FF"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#1A7A4A"/>
                    <Setter Property="BorderBrush" Value="#76F7A8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AlarmListBoxStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>
    </UserControl.Resources>

    <Viewbox Stretch="Uniform">
        <Grid Width="1380" Height="980" Background="{DynamicResource Main.Background}" Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="82"/>
                <RowDefinition Height="120"/>
                <RowDefinition Height="320"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="260"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="HISTORY" Foreground="White" FontSize="32" FontWeight="Bold"/>
                    <TextBlock Text="PCS / BMS Data, Alarm and Trend" Style="{StaticResource MutedTextStyle}" Margin="1,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Start" Style="{StaticResource FilterLabelStyle}"/>
                    <dxe:DateEdit DateTime="{Binding StartDate, Mode=TwoWay}" Style="{StaticResource TouchDatePickerStyle}"/>
                    <!--<dxe:DateNavigator/>-->
                    <!--<DatePicker SelectedDate="{Binding StartDate, Mode=TwoWay}" Style="{StaticResource TouchDatePickerStyle}"/>-->
                    <TextBlock Text="End" Style="{StaticResource FilterLabelStyle}" Margin="20,0,8,0"/>
                    <dxe:DateEdit DateTime="{Binding EndDate, Mode=TwoWay}" Style="{StaticResource TouchDatePickerStyle}"/>
                    <!--<DatePicker SelectedDate="{Binding EndDate, Mode=TwoWay}" Style="{StaticResource TouchDatePickerStyle}"/>-->
                    <dx:SimpleButton Content="Today" Command="{Binding Cmd_Today}" Style="{StaticResource ActionButtonStyle}"/>
                    <dx:SimpleButton Content="Week" Command="{Binding Cmd_Week}" Style="{StaticResource ActionButtonStyle}"/>
                    <dx:SimpleButton Content="Refresh" Command="{Binding Cmd_Refresh}" Style="{StaticResource ActionButtonStyle}"/>
                    <dx:SimpleButton Content="Export" Command="{Binding Cmd_ExportRaw}" Style="{StaticResource ActionButtonStyle}"/>

                </StackPanel>

                <TextBlock Grid.Column="2"
                           Text="{Binding StatusMessage}"
                           Foreground="#FFD5D8DC"
                           FontSize="14"
                           TextAlignment="Right"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"/>
            </Grid>

            <ItemsControl Grid.Row="1" ItemsSource="{Binding MetricCards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource PanelBorderStyle}" Margin="0,0,12,12" BorderBrush="{Binding Accent}">
                            <Grid Margin="22,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Text="{Binding Title}"
                                           Foreground="{Binding Accent}"
                                           FontSize="16"
                                           FontWeight="Bold"/>
                                <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Value}" Foreground="White" FontSize="35" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Unit}" Foreground="#FFD5D8DC" FontSize="18" Margin="14,18,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Row="2"
                                           Text="{Binding SubValue}"
                                           Foreground="#FFD5D8DC"
                                           FontSize="15"/>

                                <Ellipse Grid.Column="1"
                                         Grid.RowSpan="3"
                                         Width="14"
                                         Height="14"
                                         Fill="{Binding Accent}"
                                         VerticalAlignment="Top"
                                         HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Grid.Row="2" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource PanelBorderStyle}" Margin="0,0,6,0">
                    <Grid Margin="18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="PCS Trend" Style="{StaticResource SectionTitleStyle}"/>
                                <TextBlock Text="Total Export/Import Energy Δ" Style="{StaticResource MutedTextStyle}" Margin="16,0,0,0"/>
                                <!-- 범례: Export=초록, Import=파랑 -->
                                <Ellipse Width="10" Height="10" Fill="#76F7A8" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                <TextBlock Text="Export" Style="{StaticResource MutedTextStyle}" Margin="5,0,12,0"/>
                                <Ellipse Width="10" Height="10" Fill="#4EA5FF" VerticalAlignment="Center"/>
                                <TextBlock Text="Import" Style="{StaticResource MutedTextStyle}" Margin="5,0,0,0"/>
                            </StackPanel>
                        </Grid>

                        <s:SciChartSurface Grid.Row="1"
                                           Background="Transparent"
                                           Padding="0"
                                           MouseDoubleClick="PcsTrendChart_MouseDoubleClick">
                            <s:SciChartSurface.RenderableSeries>
                                <!-- Total Export Energy 변화량 (초록) -->
                                <s:FastLineRenderableSeries DataSeries="{Binding PcsExportTrendSeries}"
                                                            Stroke="#76F7A8"
                                                            StrokeThickness="3">
                                    <s:FastLineRenderableSeries.PointMarker>
                                        <s:EllipsePointMarker Width="5" Height="5" Fill="#76F7A8" Stroke="Transparent"/>
                                    </s:FastLineRenderableSeries.PointMarker>
                                </s:FastLineRenderableSeries>
                                <!-- Total Import Energy 변화량 (파랑) -->
                                <s:FastLineRenderableSeries DataSeries="{Binding PcsImportTrendSeries}"
                                                            Stroke="#4EA5FF"
                                                            StrokeThickness="3">
                                    <s:FastLineRenderableSeries.PointMarker>
                                        <s:EllipsePointMarker Width="5" Height="5" Fill="#4EA5FF" Stroke="Transparent"/>
                                    </s:FastLineRenderableSeries.PointMarker>
                                </s:FastLineRenderableSeries>
                            </s:SciChartSurface.RenderableSeries>
                            <s:SciChartSurface.XAxis>
                                <s:DateTimeAxis x:Name="PcsTrendXAxis"
                                                AutoRange="Never"
                                                MaxAutoTicks="10"
                                                DrawMajorBands="False"
                                                DrawMajorTicks="False"
                                                DrawMinorTicks="False"
                                                DrawMajorGridLines="False"
                                                DrawMinorGridLines="False"
                                                TextFormatting="{Binding TrendXAxisTextFormatting}"
                                                FontSize="13"
                                                Foreground="#FFE6E6E6"/>
                            </s:SciChartSurface.XAxis>
                            <s:SciChartSurface.YAxis>
                            <s:NumericAxis x:Name="PowerTrendYAxis"
                                           DrawMajorBands="False"
                                           AutoRange="Always"
                                           DrawMajorTicks="False"
                                           DrawMinorTicks="False"
                                           DrawMajorGridLines="True"
                                           DrawMinorGridLines="False"
                                           GrowBy="0.1, 0.2"
                                           MaxAutoTicks="5"
                                           FontSize="13"
                                           AxisTitle="kWh"
                                           Foreground="#FFE6E6E6"/>
                        </s:SciChartSurface.YAxis>
                            <s:SciChartSurface.ChartModifier>
                                <s:ModifierGroup>
                                    <!--<s:RolloverModifier DrawVerticalLine="True"
                                                    ShowTooltipOn="MouseOver"
                                                    ShowAxisLabels="True"/>
                                    <s:MouseWheelZoomModifier/>
                                    <s:ZoomPanModifier ExecuteOn="MouseLeftButton"/>-->
                                    <s:RolloverModifier DrawVerticalLine="True"
                                                        ShowTooltipOn="MouseOver"
                                                        ShowAxisLabels="True"/>
                                    <!-- 마우스 좌클릭 드래그로 드래그 영역 확대. 더블클릭 초기화는 code-behind에서 처리 -->
                                    <s:RubberBandXyZoomModifier ExecuteOn="MouseLeftButton"/>
                                </s:ModifierGroup>
                            </s:SciChartSurface.ChartModifier>
                        </s:SciChartSurface>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource PanelBorderStyle}" Margin="6,0,0,0">
                    <Grid Margin="18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="BMS Trend" Foreground="#FF4EA5FF" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock Text="Max BMS SOC" Style="{StaticResource MutedTextStyle}" Margin="16,0,0,0"/>
                            </StackPanel>
                            <!-- Y축 범위(Min~Max) 조절용 편집기 -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="Y" Style="{StaticResource MutedTextStyle}" Margin="0,0,6,0"/>
                                <dxe:TextEdit x:Name="BmsYMinEdit"
                                              Width="58" Height="28"
                                              VerticalContentAlignment="Center"
                                              HorizontalContentAlignment="Center"
                                              EditValuePostMode="Delayed" EditValuePostDelay="500"
                                              MaskType="Numeric" Mask="F0" MaskUseAsDisplayFormat="True"
                                              EditValue="0"
                                              EditValueChanged="BmsYRange_EditValueChanged"
                                              ToolTip="Y축 최소값"/>
                                <TextBlock Text="~" Style="{StaticResource MutedTextStyle}" Margin="6,0,6,0"/>
                                <dxe:TextEdit x:Name="BmsYMaxEdit"
                                              Width="58" Height="28"
                                              VerticalContentAlignment="Center"
                                              HorizontalContentAlignment="Center"
                                              EditValuePostMode="Delayed" EditValuePostDelay="500"
                                              MaskType="Numeric" Mask="F0" MaskUseAsDisplayFormat="True"
                                              EditValue="100"
                                              EditValueChanged="BmsYRange_EditValueChanged"
                                              ToolTip="Y축 최대값"/>
                            </StackPanel>
                        </Grid>

                        <s:SciChartSurface Grid.Row="1"
                                           Background="Transparent"
                                           Padding="0"
                                           MouseDoubleClick="BmsTrendChart_MouseDoubleClick">
                            <s:SciChartSurface.RenderableSeries>
                                <s:FastMountainRenderableSeries DataSeries="{Binding BmsTrendSeries}"
                                                                Stroke="#4EA5FF"
                                                                StrokeThickness="3"
                                                                Fill="#303A72B8"/>
                            </s:SciChartSurface.RenderableSeries>
                            <s:SciChartSurface.XAxis>
                                <s:DateTimeAxis x:Name="BmsTrendXAxis"
                                                AutoRange="Never"
                                                MaxAutoTicks="10"
                                                DrawMajorBands="False"
                                                DrawMajorTicks="False"
                                                DrawMinorTicks="False"
                                                DrawMajorGridLines="False"
                                                DrawMinorGridLines="False"
                                                TextFormatting="{Binding TrendXAxisTextFormatting}"
                                                FontSize="13"
                                                Foreground="#FFE6E6E6"/>
                            </s:SciChartSurface.XAxis>
                            <s:SciChartSurface.YAxis>
                                <s:NumericAxis x:Name="BmsTrendYAxis"
                                               AxisTitle="%"
                                               AutoRange="Never"
                                               VisibleRange="0,100"
                                               DrawMajorBands="False"
                                               DrawMajorTicks="False"
                                               DrawMinorTicks="False"
                                               DrawMajorGridLines="True"
                                               DrawMinorGridLines="False"
                                               GrowBy="0.05, 0.15"
                                               MaxAutoTicks="5"
                                               FontSize="13"
                                               Foreground="#FFE6E6E6"/>
                            </s:SciChartSurface.YAxis>
                            <s:SciChartSurface.ChartModifier>
                                <s:ModifierGroup>
                                    <s:RolloverModifier DrawVerticalLine="True"
                                                        ShowTooltipOn="MouseOver"
                                                        ShowAxisLabels="True"/>
                                    <!-- 마우스 좌클릭 드래그로 드래그 영역 확대. 더블클릭 초기화는 code-behind에서 처리 -->
                                    <s:RubberBandXyZoomModifier ExecuteOn="MouseLeftButton"/>
                                </s:ModifierGroup>
                            </s:SciChartSurface.ChartModifier>
                        </s:SciChartSurface>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="3" Style="{StaticResource PanelBorderStyle}">
                <Grid Margin="18,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="42"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="Recent Alarm" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center"/>
                        <dx:SimpleButton Content="More >"
                                         Style="{StaticResource ActionButtonStyle}"
                                         HorizontalAlignment="Right"
                                         MinWidth="86"
                                         Height="36"
                                         Margin="0,2,0,0"/>
                    </Grid>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding AlarmRows}"
                             Style="{StaticResource AlarmListBoxStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Height="65"
                                        Background="#C8182028"
                                        BorderBrush="#2D3C47"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="190"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="210"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="{Binding SeverityBrush}" CornerRadius="5,0,0,5"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
                                            <TextBlock Text="!"
                                                       Foreground="{Binding SeverityBrush}"
                                                       FontSize="30"
                                                       FontWeight="Bold"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Severity}"
                                                       Foreground="{Binding SeverityBrush}"
                                                       FontSize="18"
                                                       FontWeight="Bold"
                                                       Margin="18,0,0,0"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Message}"
                                                       Foreground="White"
                                                       FontSize="20"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                <TextBlock Text="{Binding Source}" Foreground="#FFD5D8DC" FontSize="14"/>
                                                <TextBlock Text="  |  " Foreground="#FF7A8188" FontSize="14"/>
                                                <TextBlock Text="{Binding Category}" Foreground="#FFD5D8DC" FontSize="14"/>
                                                <TextBlock Text="  |  Code: " Foreground="#FF7A8188" FontSize="14"/>
                                                <TextBlock Text="{Binding Code}" Foreground="#FFD5D8DC" FontSize="14"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding Time}"
                                                   Foreground="#FFE6E6E6"
                                                   FontSize="16"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Viewbox>
</UserControl>
