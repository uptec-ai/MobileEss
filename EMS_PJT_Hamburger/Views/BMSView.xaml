<UserControl x:Class="EMS_PJT_Hamburger.Views.BMSView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:EMS_PJT_Hamburger.Views"
             xmlns:ViewModels="clr-namespace:EMS_PJT_Hamburger.ViewModels"
             xmlns:Views="clr-namespace:EMS_PJT_Hamburger.Views"
             xmlns:Managers="clr-namespace:EMS_PJT_Hamburger.Models.Managers" 
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" 
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" 
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             mc:Ignorable="d" d:DesignHeight="860" d:DesignWidth="1200"  Background="Transparent" FontFamily="/EMS_PJT_Hamburger;component/Fonts/#Noto Sans KR"
             >
    <UserControl.Resources>
        <Managers:ReadyConverter x:Key="ReadyConverter"/>
        <Managers:OpenConverter x:Key="OpenConverter"/>
        <Managers:BoxToBrushConverter x:Key="BoxToBrushConverter"/>
        <Managers:StringToBrushConverter x:Key="StringToBrushConverter"/>
        <Managers:ValueToBrushConverter x:Key="ValueToBrushConverter"/>
        <Managers:ValueChangeToBrushConverter x:Key="ValueChangeToBrushConverter"/>
        <Managers:RelayConverter x:Key="RelayConverter"/>

        <Style TargetType="{x:Type Label}" x:Key="HeatmapLableStyle">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="{x:Type TextBlock}" x:Key="HeadTextBlockStyle">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="#FFB0FCFC"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="TextDecorations" Value="Underline"/>
            <Setter Property="FontFamily" Value="/EMS_PJT_Hamburger;component/Fonts/#Noto Sans KR"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>

        <Style TargetType="{x:Type Border}" x:Key="MainBorderStyle">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="#17212B"/>
            <Setter Property="BorderBrush" Value="#FFB0FCFC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <Style TargetType="{x:Type TextBlock}" x:Key="MonitorHeaderTextBlock">
            <Setter Property="FontFamily" Value="/EMS_PJT_Hamburger;component/Fonts/#Noto Sans KR"/>
            <Setter Property="Foreground" Value="#FFA5A5A5"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="Margin" Value="0"/>
        </Style>

        <Style TargetType="{x:Type TextBlock}" x:Key="MonitorTextBlock">
            <Setter Property="FontFamily" Value="/EMS_PJT_Hamburger;component/Fonts/#Noto Sans KR"/>
            <Setter Property="Foreground" Value="#FFC3C3C3"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="Margin" Value="0,-3,0,0"/>
        </Style>

        <Style TargetType="{x:Type Image}" x:Key="ImageStyle">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Margin" Value="14,0,0,0"/>
            <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality"/>
        </Style>

        <Style TargetType="{x:Type Grid}" x:Key="MonitoringGrid">
            <Setter Property="Width" Value="280"/>
            <Setter Property="Height" Value="180"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Background">
                <Setter.Value>
                    <ImageBrush ImageSource="/EMS_PJT_Hamburger;component/Assets/BMS/BMS_Monitoring.png"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- PCS View 테마에 맞춘 상단 카드 스타일 -->
        <Style x:Key="PanelBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#D90F151B"/>
            <Setter Property="BorderBrush" Value="#2A3D4A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>

        <Style x:Key="CardLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFD2D7DC"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="/EMS_PJT_Hamburger;component/Fonts/#Noto Sans KR"/>
        </Style>

        <Style x:Key="CardValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="/EMS_PJT_Hamburger;component/Fonts/#Noto Sans KR"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </UserControl.Resources>

    <Viewbox>
        <!-- PCSView와 동일하게 도킹 없이 단일 Grid 루트 사용 (구 DockLayoutManager 제거) -->
        <Grid Height="860" Width="1200" Background="{DynamicResource Main.Background}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="0"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="64"/>
                            <RowDefinition Height="80"/>
                            <RowDefinition Height="80"/>
                            <RowDefinition/>
                            <RowDefinition Height="0"/>
                        </Grid.RowDefinitions>

                        <!-- 상단 헤더: BMS DETAIL 타이틀 + System Connect 상태 패널 (PCS View 헤더 대응) -->
                        <Grid Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="0" Margin="10,4,10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel Margin="6,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="BMS DETAIL" Foreground="White" FontWeight="Bold" FontSize="28" VerticalAlignment="Center"/>
                                    <TextBlock Text="Battery Management System" Foreground="#FFD2D7DC" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Relay 제어 / Alarm — 구 Control 도킹 패널에서 이동 (PCSView 헤더의 제어 버튼 배치 대응) -->
                                <Border Background="#121922" BorderBrush="#2A3D4A" BorderThickness="1" CornerRadius="4" Padding="12,5" Margin="18,0,0,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Relay 제어" Foreground="#FFD2D7DC" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <dx:SimpleButton Width="72" Height="28" Padding="0"
                                                         ButtonKind="Toggle"
                                                         Content="{Binding RelayStatus, Converter={StaticResource RelayConverter}}"
                                                         IsChecked="{Binding RelayStatus}"
                                                         Command="{Binding Cmd_RelayBtn}"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#121922" BorderBrush="#2A3D4A" BorderThickness="1" CornerRadius="4" Padding="12,5" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Alarm" Foreground="#FFD2D7DC" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding Alarms}" Foreground="White" FontSize="14" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <dx:SimpleButton Height="28" Padding="8,0"
                                                         Content="BMS Fault Message"
                                                         IsEnabled="{Binding AlarmWindowOpen}"
                                                         Command="{Binding Cmd_AlarmsPopupBtn}"
                                                         Glyph="{dx:DXImage 'SvgImages/Icon Builder/Security_Warning.svg'}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                                <TextBlock Text="Last Update" Foreground="#FFD2D7DC" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <Border Background="#121922" BorderBrush="#2A3D4A" BorderThickness="1" CornerRadius="4" Padding="16,8" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding BmsTime}" Foreground="White" FontSize="14" VerticalAlignment="Center"/>
                                </Border>
                                <Border BorderThickness="1" CornerRadius="4" Padding="12,8">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#4A1515"/>
                                            <Setter Property="BorderBrush" Value="#8C3A3A"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBmsConnected}" Value="True">
                                                    <Setter Property="Background" Value="#15391F"/>
                                                    <Setter Property="BorderBrush" Value="#2C7F41"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,7,0">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="#FF6B6B"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsBmsConnected}" Value="True">
                                                            <Setter Property="Fill" Value="#76F7A8"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding BmsConnectionStatus}" Foreground="White" FontSize="14" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <UniformGrid Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1" Columns="6" Margin="5,4,5,2">
                            <Border Style="{StaticResource PanelBorderStyle}" Margin="4,2">
                                <StackPanel Margin="14,4" VerticalAlignment="Center">
                                    <TextBlock Text="RELAY" Style="{StaticResource CardLabelStyle}"/>
                                    <TextBlock Style="{StaticResource CardValueStyle}">
                                        <Run Text="{Binding StatusMsg01.Ready}" FontSize="24"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource PanelBorderStyle}" Margin="4,2">
                                <StackPanel Margin="14,4" VerticalAlignment="Center">
                                    <TextBlock Text="TOTAL CURR." Style="{StaticResource CardLabelStyle}"/>
                                    <TextBlock Style="{StaticResource CardValueStyle}">
                                        <Run Text="{Binding StatusMsg01.TotalCurrent, StringFormat=F2}" FontSize="24"/>
                                        <Run Text=" A" FontSize="14" Foreground="#FFD2D7DC"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource PanelBorderStyle}" Margin="4,2">
                                <StackPanel Margin="14,4" VerticalAlignment="Center">
                                    <TextBlock Text="TOTAL VOLT." Style="{StaticResource CardLabelStyle}"/>
                                    <TextBlock Style="{StaticResource CardValueStyle}">
                                        <Run Text="{Binding StatusMsg01.TotalVoltage, StringFormat=F2}" FontSize="24"/>
                                        <Run Text=" V" FontSize="14" Foreground="#FFD2D7DC"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource PanelBorderStyle}" Margin="4,2">
                                <StackPanel Margin="14,4" VerticalAlignment="Center">
                                    <TextBlock Text="STATE" Style="{StaticResource CardLabelStyle}"/>
                                    <TextBlock Style="{StaticResource CardValueStyle}">
                                        <Run Text="{Binding StatusMsg01.MbmsState, StringFormat=0x{0:X2}}" FontSize="24"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource PanelBorderStyle}" Margin="4,2">
                                <StackPanel Margin="14,4" VerticalAlignment="Center">
                                    <TextBlock Text="SOC" Style="{StaticResource CardLabelStyle}"/>
                                    <TextBlock Style="{StaticResource CardValueStyle}">
                                        <Run Text="{Binding StatusMsg01.DispSOC}" FontSize="24"/>
                                        <Run Text=" %" FontSize="14" Foreground="#FFD2D7DC"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource PanelBorderStyle}" Margin="4,2">
                                <StackPanel Margin="14,4" VerticalAlignment="Center">
                                    <TextBlock Text="SOH" Style="{StaticResource CardLabelStyle}"/>
                                    <TextBlock Style="{StaticResource CardValueStyle}">
                                        <Run Text="{Binding StatusMsg01.DispSOC}" FontSize="24"/>
                                        <Run Text=" %" FontSize="14" Foreground="#FFD2D7DC"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <UniformGrid Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="2" Columns="6" Margin="5,2,5,4">
                            <Border Style="{StaticResource PanelBorderStyle}" Margin="4,2">
                                <StackPanel Margin="14,4" VerticalAlignment="Center">
                                    <TextBlock Text="MBMS READY" Style="{StaticResource CardLabelStyle}"/>
                                    <TextBlock Style="{StaticResource CardValueStyle}">
                                        <Run Text="{Binding StatusMsg03.MbmsReady}" FontSize="24"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource PanelBorderStyle}" Margin="4,2">
                                <StackPanel Margin="14,4" VerticalAlignment="Center">
                                    <TextBlock Text="PACK READY FLAG" Style="{StaticResource CardLabelStyle}"/>
                                    <ItemsControl ItemsSource="{Binding Packs}"
                                                  Width="121" Height="30"
                                                  HorizontalAlignment="Left"
                                                  Margin="0,10,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <!--8열 고정, 개수만큼 자동으로 다음 행으로 넘어감-->
                                                <UniformGrid Columns="8"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0"
                                                        CornerRadius="1"
                                                        Width="5" Height="8"
                                                        Background="{Binding IsOnline, Converter={StaticResource BoxToBrushConverter}}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource PanelBorderStyle}" Margin="4,2">
                                <StackPanel Margin="14,4" VerticalAlignment="Center">
                                    <TextBlock Text="CURR. PACK CNT." Style="{StaticResource CardLabelStyle}"/>
                                    <TextBlock Style="{StaticResource CardValueStyle}">
                                        <Run Text="{Binding StatusMsg03.CurrentPackCount}" FontSize="24"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource PanelBorderStyle}" Margin="4,2">
                                <StackPanel Margin="14,4" VerticalAlignment="Center">
                                    <TextBlock Text="CELL MIN VOLT. / NUM." Style="{StaticResource CardLabelStyle}"/>
                                    <TextBlock Style="{StaticResource CardValueStyle}">
                                        <Run Text="{Binding StatusMsg04.CellMinVoltage, StringFormat={}{0:F2}}" FontSize="20"/>
                                        <Run Text="V" FontSize="13" Foreground="#FFD2D7DC"/>
                                        <Run Text=" / " FontSize="14" Foreground="#FF7A8188"/>
                                        <Run Text="{Binding StatusMsg04.CellMinPackNumber, StringFormat=#{0:D2}}" FontSize="15" Foreground="#FFD2D7DC"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource PanelBorderStyle}" Margin="4,2">
                                <StackPanel Margin="14,4" VerticalAlignment="Center">
                                    <TextBlock Text="MAX TEMP. / NUM." Style="{StaticResource CardLabelStyle}"/>
                                    <TextBlock Style="{StaticResource CardValueStyle}">
                                        <Run Text="{Binding StatusMsg04.MaxTemperature}" FontSize="20"/>
                                        <Run Text="℃" FontSize="13" Foreground="#FFD2D7DC"/>
                                        <Run Text=" / " FontSize="14" Foreground="#FF7A8188"/>
                                        <Run Text="{Binding StatusMsg04.MaxTemperaturePackNumber, StringFormat=#{0:D2}}" FontSize="15" Foreground="#FFD2D7DC"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource PanelBorderStyle}" Margin="4,2">
                                <StackPanel Margin="14,4" VerticalAlignment="Center">
                                    <TextBlock Text="MIN TEMP. / NUM." Style="{StaticResource CardLabelStyle}"/>
                                    <TextBlock Style="{StaticResource CardValueStyle}">
                                        <Run Text="{Binding StatusMsg04.MinTemperature}" FontSize="20"/>
                                        <Run Text="℃" FontSize="13" Foreground="#FFD2D7DC"/>
                                        <Run Text=" / " FontSize="14" Foreground="#FF7A8188"/>
                                        <Run Text="{Binding StatusMsg04.MinTemperaturePackNumber, StringFormat=#{0:D2}}" FontSize="15" Foreground="#FFD2D7DC"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Grid Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="3" HorizontalAlignment="Stretch" Background="Transparent">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <ScrollViewer Grid.Row="1" Margin="10,10,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="170"/>
                                        <RowDefinition Height="170"/>
                                        <RowDefinition Height="170"/>
                                        <RowDefinition Height="170"/>
                                        <RowDefinition Height="170"/>
                                    </Grid.RowDefinitions>

                                    <ItemsControl ItemsSource="{Binding Packs}" Grid.Column="0" Grid.ColumnSpan="4" Grid.Row="0" Grid.RowSpan="5">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <!-- 첨부 이미지처럼 가로로 여러개, 줄바꿈 -->
                                                <UniformGrid Columns="4" Rows="5"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>

                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <!-- 여기 스타일을 네 MonitoringGrid로 -->
                                                <Grid Style="{StaticResource MonitoringGrid}">
                                                    <TextBlock Text="{Binding PackNo, StringFormat=Pack #{0}}"
                                                               Foreground="White"
                                                               Margin="25,15,0,0"
                                                               HorizontalAlignment="Left"
                                                               VerticalAlignment="Top"
                                                               FontWeight="Bold"
                                                               FontSize="10"/>

                                                    <!-- Online 표시: IsOnline에 따라 색 변경 -->
                                                    <Ellipse Width="5" Height="5"
                                                             HorizontalAlignment="Left"
                                                             VerticalAlignment="Top"
                                                             Margin="161,22,0,0">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="#FFA5A5A5"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                                        <Setter Property="Fill" Value="Lime"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <Grid Margin="8,35,12,18">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="*"/>
                                                            <RowDefinition Height="*"/>
                                                        </Grid.RowDefinitions>

                                                        <!-- Max Volt -->
                                                        <StackPanel Grid.Column="0" Orientation="Vertical">
                                                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                                <Image Source="/EMS_PJT_Hamburger;component/Assets/BMS/volt.png"
                                                                       Style="{StaticResource ImageStyle}"/>
                                                                <TextBlock Text="Max Volt." FontSize="14"
                                                                           Style="{StaticResource MonitorHeaderTextBlock}"/>
                                                            </StackPanel>
                                                            <TextBlock Style="{StaticResource MonitorTextBlock}">
                                                                <Run Text="{Binding MaxCellVoltage, StringFormat=F2}" Foreground="{Binding IsOnline, Converter={StaticResource ValueChangeToBrushConverter}}"/>
                                                                <Run Text=" V" FontSize="16"/>
                                                            </TextBlock>
                                                        </StackPanel>

                                                        <!-- Min Volt -->
                                                        <StackPanel Grid.Column="0" Grid.Row="1" Orientation="Vertical">
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                                                <Image Source="/EMS_PJT_Hamburger;component/Assets/BMS/volt.png"
                                                                       Style="{StaticResource ImageStyle}"/>
                                                                <TextBlock Text="Min Volt." FontSize="14"
                                                                           Style="{StaticResource MonitorHeaderTextBlock}"/>
                                                            </StackPanel>
                                                            <TextBlock Style="{StaticResource MonitorTextBlock}">
                                                                <Run Text="{Binding MinCellVoltage, StringFormat=F2}" Foreground="{Binding IsOnline, Converter={StaticResource ValueChangeToBrushConverter}}"/>
                                                                <Run Text=" V" FontSize="16"/>
                                                            </TextBlock>
                                                        </StackPanel>

                                                        <!-- Max Temp -->
                                                        <StackPanel Grid.Column="1" Orientation="Vertical">
                                                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                                <Image Source="/EMS_PJT_Hamburger;component/Assets/BMS/온도.png"
                                                                       Style="{StaticResource ImageStyle}"/>
                                                                <TextBlock Text="Max Temp." FontSize="14"
                                                                           Style="{StaticResource MonitorHeaderTextBlock}"/>
                                                            </StackPanel>
                                                            <TextBlock Style="{StaticResource MonitorTextBlock}">
                                                                <Run Text="{Binding MaxTemperature, StringFormat=F2}" Foreground="{Binding IsOnline, Converter={StaticResource ValueChangeToBrushConverter}}"/>
                                                                <Run Text=" ℃" FontSize="16"/>
                                                            </TextBlock>
                                                        </StackPanel>

                                                        <!-- Min Temp -->
                                                        <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Vertical">
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                                                <Image Source="/EMS_PJT_Hamburger;component/Assets/BMS/온도.png"
                                                                       Style="{StaticResource ImageStyle}"/>
                                                                <TextBlock Text="Min Temp." FontSize="14"
                                                                           Style="{StaticResource MonitorHeaderTextBlock}"/>
                                                            </StackPanel>
                                                            <TextBlock Style="{StaticResource MonitorTextBlock}">
                                                                <Run Text="{Binding MinTemperature, StringFormat=F2}" Foreground="{Binding IsOnline, Converter={StaticResource ValueChangeToBrushConverter}}"/>
                                                                <Run Text=" ℃" FontSize="16"/>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Grid>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!--#region Pack #17 -->
                                    <!--<Grid Grid.Column="0" Grid.Row="4"
                              Style="{StaticResource MonitoringGrid}">
                            <TextBlock Text="Pack #17" Foreground="White" Margin="20,13,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="10" Height="11" />
                            <Ellipse Fill="Lime" Width="5" Height="5" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="131,17,0,0"/>
                            <Grid Margin="8,24,12,18" >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Vertical">
                                    <StackPanel Orientation="Horizontal" 
                                            Margin="0,3,0,0" >
                                        <Image Source="/EMS_PJT_Hamburger;component/Assets/BMS/volt.png"
                                           Style="{StaticResource ImageStyle}"/>
                                        <TextBlock Text="Max Volt." FontSize="14"
                                               Style="{StaticResource MonitorHeaderTextBlock}"/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource MonitorTextBlock}" >
                                    <Run Text="24.0" Foreground="White"/>
                                    <Run Text="V" FontSize="16"/>
                                    </TextBlock>
                                </StackPanel>

                                <StackPanel Grid.Column="0" Grid.Row="1" Orientation="Vertical">
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0" >
                                        <Image Source="/EMS_PJT_Hamburger;component/Assets/BMS/volt.png"
                                           Style="{StaticResource ImageStyle}"/>
                                        <TextBlock Text="Min Volt." FontSize="14"
                                                Style="{StaticResource MonitorHeaderTextBlock}"/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource MonitorTextBlock}">
                                    <Run Text="22.0" Foreground="White"/>
                                    <Run Text="V" FontSize="16"/>
                                    </TextBlock>
