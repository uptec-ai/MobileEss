                                    <TextBlock x:Name="ZoomLabel" Foreground="#CCFFFFFF" FontSize="11"
                                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
