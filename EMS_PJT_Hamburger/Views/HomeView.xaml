                            <Run Text="Lat " Foreground="#FF87FFFF"/><Run Text="{Binding GpsLatitude}"/>
                        </TextBlock>
                        <TextBlock Margin="12,0,0,0" Foreground="White" FontSize="13" VerticalAlignment="Center">
                            <Run Text="Lon " Foreground="#FF87FFFF"/><Run Text="{Binding GpsLongitude}"/>
                        </TextBlock>
                        <TextBlock Margin="12,0,0,0" Foreground="#FFD5D8DC" FontSize="11" VerticalAlignment="Center">
                            <Run Text="Sat "/><Run Text="{Binding GpsSatelliteCount}"/>
                        </TextBlock>
                    </StackPanel>

                    <!-- Row 1: DevExpress 오프라인 지도 호스트.
                         · 래스터 타일(OSM ImageLayer)은 code-behind(ConfigureMap)에서 file:// 로 부착
                           → 디자이너 네트워크 접근 방지 + 완전 오프라인.
                         · 중심(CenterPoint)은 VM(MapCenterLatitude/Longitude)에 바인딩 → 초기값이 렌더 전에
                           적용되어 (0,0)→목표 팬 애니메이션이 없고, GPS 갱신 시 follow 도 자동 반영.
                         · 마커(현재 위치)는 MarkerStorage 에 code-behind 에서 1개 추가/갱신. -->
                    <Border Grid.Row="1" Grid.Column="0" x:Name="MapHost" Margin="0,6,0,0"
                            CornerRadius="4" BorderThickness="1" BorderBrush="#334F5E"
                            ClipToBounds="True">
                        <Grid>
                            <dxm:MapControl x:Name="Map" ZoomLevel="12" EnableRotation="False"
