                        <TextBlock Text="GPS" Foreground="#FFB0FCFC" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Ellipse Width="9" Height="9" Margin="8,0,0,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#FF6B6B"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding GpsIsValid}" Value="True">
                                            <Setter Property="Fill" Value="#76F7A8"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <!-- 시/도/군 (오프라인 역지오코딩 결과) -->
