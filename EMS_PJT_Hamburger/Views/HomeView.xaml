<UserControl x:Class="EMS_PJT_Hamburger.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:EMS_PJT_Hamburger.Views"
             xmlns:ViewModels="clr-namespace:EMS_PJT_Hamburger.ViewModels"
             xmlns:Models="clr-namespace:EMS_PJT_Hamburger.Models"
             xmlns:Managers="clr-namespace:EMS_PJT_Hamburger.Models.Managers"
             xmlns:conv="clr-namespace:EMS_PJT_Hamburger.Converters"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxm="http://schemas.devexpress.com/winfx/2008/xaml/map"
             mc:Ignorable="d" d:DesignHeight="704" d:DesignWidth="1000" Background="Transparent" 
             FontFamily="/EMS_PJT_Hamburger;component/Fonts/#Noto Sans KR">
    <UserControl.Resources>
        <Managers:RelayConverter x:Key="RelayConverter"/>
        <Managers:RunFaultStatusConverter x:Key="RunFaultStatusConverter"/>
        <Managers:HomeStatusMatchConverter x:Key="HomeStatusMatchConverter"/>
        <Managers:ChargeToBrushConverter x:Key="ChargeToBrushConverter"/>
        <Managers:FaultConverter x:Key="FaultConverter"/>

        <!-- GPS 지도(DevExpress MapControl) 마커/중심 바인딩용 컨버터 -->
        <conv:ScaleNegConverter x:Key="ScaleNeg"/>
        <conv:LatLngToGeoConverter x:Key="LatLngToGeo"/>

        <!-- 현재 GPS 위치 마커: 좌표 라벨(흰 배경/검은 글자) + 위치 점.
             콘텐츠 하단중앙이 좌표에 오도록 RenderTransform 으로 앵커 보정. -->
        <DataTemplate x:Key="MarkerLabelTemplate">
            <Grid x:Name="MarkerRoot">
                <Grid.RenderTransform>
                    <TranslateTransform
                        X="{Binding ActualWidth,  ElementName=MarkerRoot, Converter={StaticResource ScaleNeg}, ConverterParameter=0.5}"
                        Y="{Binding ActualHeight, ElementName=MarkerRoot, Converter={StaticResource ScaleNeg}, ConverterParameter=1}"/>
                </Grid.RenderTransform>
                <StackPanel HorizontalAlignment="Center">
                    <Border CornerRadius="7" Padding="7,2" HorizontalAlignment="Center"
                            Background="#F2FFFFFF" BorderBrush="#59000000" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="6" ShadowDepth="0" Opacity="0.4"/>
                        </Border.Effect>
                        <TextBlock Text="{Binding}" Foreground="Black" FontWeight="Bold" FontSize="11"
                                   FontFamily="Malgun Gothic, Segoe UI"/>
                    </Border>
                    <Border Height="2"/>
                    <Ellipse Width="13" Height="13" Fill="#76F7A8" Stroke="White" StrokeThickness="2.5"
                             HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <Style TargetType="Border" x:Key="ChargeStoryBorderStyle">
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Width" Value="220"/>
            <Setter Property="Height" Value="170"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush>
                        <GradientStop Color="#0E1012" Offset="0"/>
                        <GradientStop Color="#FF2C3D4D" Offset="0.5"/>
                        <GradientStop Color="#0E1012" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Border" x:Key="DischargeStoryBorderStyle">
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Width" Value="220"/>
            <Setter Property="Height" Value="170"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush>
                        <GradientStop Color="#0E1012" Offset="0"/>
                        <GradientStop Color="#FF2C3D4D" Offset="0.5"/>
                        <GradientStop Color="#0E1012" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Border" x:Key="DefaultBorderStyle">
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Width" Value="160"/>
            <Setter Property="Height" Value="120"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Main.MouseOver}"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush>
                        <GradientStop Color="#0E1012" Offset="0"/>
                        <GradientStop Color="#FF151D25" Offset="0.5"/>
                        <GradientStop Color="#0E1012" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Border" x:Key="ContentBorderStyle">
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Width" Value="50"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#FFB0FCFC"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="2" ShadowDepth="0" Direction="0" Color="Cyan" Opacity="1"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBlock" x:Key="DefaultTextBlockStyle">
            <Setter Property="Width" Value="120"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextDecorations" Value="Underline"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style TargetType="Image" x:Key="DefaultImageStyle">
            <Setter Property="Width" Value="60"/>
            <Setter Property="Height" Value="60"/>
            <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality"/>
        </Style>

        <Style TargetType="Path" x:Key="NotusedPathStyle">
            <Setter Property="StrokeDashOffset" Value="0"/>
            <Setter Property="StrokeThickness" Value="3"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="Stroke" Value="#FF464646"/>
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="Fill" Value="Transparent"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" 
                                      ShadowDepth="0" 
                                      Direction="0" 
                                      Color="#FF0C1103" 
                                      Opacity="1"
                                      RenderingBias="Performance"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Path" x:Key="ChargingPathStyle">
            <Setter Property="StrokeDashOffset" Value="0"/>
            <Setter Property="StrokeThickness" Value="3"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="Stroke" Value="#FFDEFBB2"/>
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="Fill" Value="Transparent"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" 
                                      ShadowDepth="0" 
                                      Direction="0" 
                                      Color="GreenYellow" 
                                      Opacity="1"
                                      RenderingBias="Performance"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Path" x:Key="DisChargingPathStyle">
            <Setter Property="StrokeDashOffset" Value="0"/>
            <Setter Property="StrokeThickness" Value="3"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="Stroke" Value="#FFFDE2B0"/>
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="Fill" Value="Transparent"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" 
                                      ShadowDepth="0" 
                                      Direction="0" 
                                      Color="Orange" 
                                      Opacity="1"
                                      RenderingBias="Performance"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Label" x:Key="ConnLableStyle">
            <Setter Property="Width" Value="45"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="#87FFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#87FFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="Label" x:Key="PLableStyle">
            <Setter Property="Width" Value="65"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#87FFFF"/>
            <Setter Property="BorderThickness" Value="1"/>

            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static Models:HomeStatus.Charging}">
                    <Setter Property="Content" Value="Charge"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static Models:HomeStatus.Discharging}">
                    <Setter Property="Content" Value="Discharge"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static Models:HomeStatus.Waiting}">
                    <Setter Property="Content" Value="Stop"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Label" x:Key="BLableStyle">
            <Setter Property="Width" Value="65"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#87FFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static Models:HomeStatus.Charging}">
                    <Setter Property="Content" Value="Charge"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static Models:HomeStatus.Discharging}">
                    <Setter Property="Content" Value="Discharge"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static Models:HomeStatus.Waiting}">
                    <Setter Property="Content" Value="Stop"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Label" x:Key="LoadLableStyle">
            <Setter Property="Width" Value="65"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#87FFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Content" Value="Consume"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="False">
                    <Setter Property="Content" Value="Stop"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Label" x:Key="CouplingLableStyle">
            <Setter Property="Height" Value="20"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="#87FFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#87FFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Content" Value="Active"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="False">
                    <Setter Property="Content" Value="Standby"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Label" x:Key="EVChargerLableStyle">
            <Setter Property="Height" Value="20"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="#87FFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#87FFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Content" Value="Active"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="False">
                    <Setter Property="Content" Value="Standby"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Label" x:Key="InfoLableStyle">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Padding" Value="3,0,0,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#FFB0FCFC"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="Label" x:Key="HeaderLableStyle">
            <Setter Property="Padding" Value="0,3,0,0"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
            <Setter Property="Foreground" Value="#FFB0FCFC"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="Image" x:Key="HeaderImageStyle">
            <Setter Property="Margin" Value="9,5,9,0"/>
            <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="ContentTextBlockStyle">
            <Setter Property="Margin" Value="0,-3,0,0"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="{x:Type dx:SimpleButton}" x:Key="HomeQuickActionButtonStyle">
            <Setter Property="Width" Value="66"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#273642"/>
            <Setter Property="BorderBrush" Value="#FFB0FCFC"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="{x:Type dx:SimpleButton}" x:Key="HomeChargeButtonStyle" BasedOn="{StaticResource HomeQuickActionButtonStyle}">
            <Setter Property="Background" Value="#1E7154"/>
            <Setter Property="BorderBrush" Value="#76F7A8"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2FAF75"/>
                    <Setter Property="BorderBrush" Value="#B6FFD0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type dx:SimpleButton}" x:Key="HomeDischargeButtonStyle" BasedOn="{StaticResource HomeQuickActionButtonStyle}">
            <Setter Property="Background" Value="#8A5A1E"/>
            <Setter Property="BorderBrush" Value="#FFE2A6"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C07A25"/>
                    <Setter Property="BorderBrush" Value="#FFF0C7"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type dx:SimpleButton}" x:Key="HomeStopButtonStyle" BasedOn="{StaticResource HomeQuickActionButtonStyle}">
            <Setter Property="Background" Value="#7B2525"/>
            <Setter Property="BorderBrush" Value="#FF8C8C"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#B53636"/>
                    <Setter Property="BorderBrush" Value="#FFC0C0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type dx:SimpleButton}" x:Key="HomeRelayButtonStyle" BasedOn="{StaticResource HomeQuickActionButtonStyle}">
            <Setter Property="Width" Value="88"/>
            <Setter Property="Background" Value="#244656"/>
            <Setter Property="BorderBrush" Value="#87FFFF"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2C6A7D"/>
                    <Setter Property="BorderBrush" Value="#C9FFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBlock" x:Key="HomeHeaderTitleTextStyle">
            <Setter Property="Foreground" Value="#FFB0FCFC"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="HomeHeaderModeTextStyle">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static Models:HomeStatus.Charging}">
                    <Setter Property="Text" Value="충전 중"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static Models:HomeStatus.Discharging}">
                    <Setter Property="Text" Value="방전 중"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static Models:HomeStatus.Waiting}">
                    <Setter Property="Foreground" Value="Gray"/>
                    <Setter Property="Text" Value="대기"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type ToggleButton}" x:Key="TouchKeyboardToggleStyle">
            <Setter Property="Width" Value="65"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="Background" Value="#FF3D4654"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="Track"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12">
                            <Grid Margin="3">
                                <TextBlock x:Name="SwitchText"
                                           Text="OFF"
                                           Foreground="#FFC3C3C3"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"
                                           Margin="0,0,8,0"/>
                                <Ellipse x:Name="Thumb"
                                         Width="19"
                                         Height="19"
                                         Fill="White"
                                         HorizontalAlignment="Left" Margin="0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#FF2D8F75"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="SwitchText" Property="Text" Value="ON"/>
                                <Setter TargetName="SwitchText" Property="Foreground" Value="White"/>
                                <Setter TargetName="SwitchText" Property="HorizontalAlignment" Value="Left"/>
                                <Setter TargetName="SwitchText" Property="Margin" Value="8,0,4,0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type RadioButton}" x:Key="LoadTargetToggleStyle">
            <Setter Property="Width" Value="70"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Foreground" Value="#FFC3C3C3"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border x:Name="ToggleBox"
                                Background="#273642"
                                BorderBrush="#FFB0FCFC"
                                BorderThickness="1"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToggleBox" Property="Background" Value="#8A5A1E"/>
                                <Setter TargetName="ToggleBox" Property="BorderBrush" Value="#FFE2A6"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleBox" Property="BorderBrush" Value="#C9FFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Viewbox>
        <Canvas Height="705" Width="1000" Margin="0" Background="{DynamicResource Main.Background}">
            <StackPanel Orientation="Horizontal" Height="55" Margin="0,5,0,0">
                <Border Canvas.Left="22" Canvas.Top="14" Width="185"
                        CornerRadius="5"
                        BorderThickness="1"
                        BorderBrush="#334F5E"
                        Background="#CC15181C" Margin="20,0,0,0" Height="55">
                    <Grid Margin="0" Width="169" HorizontalAlignment="Left" >
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Width="160" Margin="10,0,0,0">
                            <TextBlock Grid.Column="0" Text="운전 모드"
                                       Style="{StaticResource HomeHeaderTitleTextStyle}"/>
                            <Ellipse Width="12"
                                     Height="12"
                                     Margin="20,0,10,0"
                                     Fill="{Binding OperationModeBrush}">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="10"
                                                      ShadowDepth="0"
                                                      Direction="0"
                                                      Color="Cyan"
                                                      Opacity="0.8"/>
                                </Ellipse.Effect>
                                <Ellipse.Resources>
                                    <Storyboard x:Key="BlinkStoryboard"
                                                RepeatBehavior="Forever"
                                                AutoReverse="True">

                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="1.0"
                                                         To="0.25"
                                                         Duration="0:0:0.6"/>

                                        <DoubleAnimation Storyboard.TargetProperty="Effect.Opacity"
                                                         From="0.9"
                                                         To="0.1"
                                                         Duration="0:0:0.6"/>
                                    </Storyboard>
                                </Ellipse.Resources>
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">

                                        <!-- 기본 상태 -->
                                        <Setter Property="Opacity" Value="1"/>

                                        <Style.Triggers>

                                            <!-- Charging -->
                                            <DataTrigger Binding="{Binding ChargingStatus}"
                                                         Value="Charging">

                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard Name="BlinkAnimation"
                                                                     Storyboard="{StaticResource BlinkStoryboard}"/>
                                                </DataTrigger.EnterActions>

                                                <DataTrigger.ExitActions>
                                                    <StopStoryboard BeginStoryboardName="BlinkAnimation"/>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>

                                            <!-- Discharging -->
                                            <DataTrigger Binding="{Binding ChargingStatus}"
                                                         Value="Discharging">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard Name="BlinkAnimation2"
                                                                     Storyboard="{StaticResource BlinkStoryboard}"/>
                                                </DataTrigger.EnterActions>

                                                <DataTrigger.ExitActions>
                                                    <StopStoryboard BeginStoryboardName="BlinkAnimation2"/>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>

                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Tag="{Binding ChargingStatus}"
