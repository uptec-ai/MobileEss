                                <dxm:MapControl.CoordinatesPanelOptions>
                                    <dxm:CoordinatesPanelOptions Visible="False"/>
                                </dxm:MapControl.CoordinatesPanelOptions>
                                <dxm:MapControl.CenterPoint>
                                    <MultiBinding Converter="{StaticResource LatLngToGeo}">
                                        <Binding Path="MapCenterLatitude"/>
                                        <Binding Path="MapCenterLongitude"/>
                                    </MultiBinding>
                                </dxm:MapControl.CenterPoint>
                                <dxm:VectorLayer>
                                    <dxm:VectorLayer.Data>
                                        <dxm:MapItemStorage x:Name="MarkerStorage"/>
                                    </dxm:VectorLayer.Data>
                                </dxm:VectorLayer>
                            </dxm:MapControl>

                            <!-- 배율 선택 / 오프라인 상태 (우하단). 준비된 타일 레벨: 8/10/12/15 -->
                            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    Margin="6" Padding="7,3"
